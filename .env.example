# COS-PLAY — Required API Keys
# Copy this file to .env and fill in your keys.
# Then export them: `set -a && source .env && set +a`

# ── Model stack (current phase) ─────────────────────────────────────────
# - Actor + skill-bank trained model:    Qwen/Qwen3.5-9B           (vLLM, :8000)
# - Crafter / harness / orchestrator
#   + LLM-as-judge (skill eval / E0-E2): Qwen/Qwen3.5-35B-A3B      (vLLM, :8001)
#                                        ^ same weights for both roles, served once
# - SFT cold-start data teacher:         gpt-5.5                   (OpenAI / OpenRouter)
# See common/models.py for the canonical constants and override env-vars.
# `inference/serve_qwen35_35b_a3b.sh` is the one-shot launcher for the
# 35B endpoint and `scripts/use_35b_judge.sh` exports the matching
# VLLM_BASE_URL_MAP — without that map a 35B judge call would hit the
# 9B port and fail.

# OpenAI (for gpt-5.5 SFT cold-start teacher; ALSO used as the
# off-distribution judge oracle when overriding for paper / formal
# eval runs — see VLM_AGENT_BACKBONE_JUDGE_MODEL below).
OPENAI_API_KEY=sk-...

# Anthropic (for Claude baselines)
ANTHROPIC_API_KEY=sk-ant-...

# Google (for Gemini baselines)
GEMINI_API_KEY=AIza...

# OpenRouter (optional — unified API for all models; preferred for
# cold-start / SFT data generation when a single key is convenient).
OPENROUTER_API_KEY=sk-or-...

# vLLM (for local Qwen/Qwen3.5-9B actor + skill-bank inference during
# training and evaluation).
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# Per-model vLLM endpoint dispatch (REQUIRED whenever you actually want
# the judge / crafter / harness control-plane calls to land on the 35B
# server — without this map every "Qwen/Qwen3.5-35B-A3B" request would
# hit the 9B endpoint and either silently return 9B completions or fail
# with a model-mismatch error).  Format is
# `model_id_1=url_1,model_id_2=url_2,...`.  Models not in this map fall
# back to VLLM_BASE_URLS / VLLM_BASE_URL.  Wired by
# API_func._candidate_vllm_urls; contract pinned by
# tests/test_api_func_routing.py.
#
# Use `source scripts/use_35b_judge.sh` to set this + reachability-check
# both ports in one go.
VLLM_BASE_URL_MAP=Qwen/Qwen3.5-9B=http://localhost:8000/v1,Qwen/Qwen3.5-35B-A3B=http://localhost:8001/v1

# Optional: override any tier of the backbone stack at process start.
# VLM_AGENT_BACKBONE_MODEL=Qwen/Qwen3.5-9B
# VLM_AGENT_BACKBONE_TEACHER_MODEL=Qwen/Qwen3.5-35B-A3B
# Judge defaults to the local 35B-A3B teacher (no API spend, see
# common/models.py for rationale).  Override to gpt-5.5 ONLY for
# paper / formal eval where the within-Qwen-family self-preference
# bias must be controlled — run a 5% disagreement-rate spot-check
# per the protocol in
# implementation_notes/coevolution-cross-domain-integration.md
# §"Judge family bias".
# VLM_AGENT_BACKBONE_JUDGE_MODEL=Qwen/Qwen3.5-35B-A3B    # default
# VLM_AGENT_BACKBONE_JUDGE_MODEL=gpt-5.5                 # off-distribution oracle
# VLM_AGENT_BACKBONE_SFT_TEACHER_MODEL=gpt-5.5
